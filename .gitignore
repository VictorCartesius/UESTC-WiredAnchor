# ---- Runtime artifacts ----
# Daily run logs (they contain the local IP / timestamps, so they must not be committed).
main/logs/

# ---- Credential safety (defensive) ----
# Credentials live in user environment variables; no local credential file should ever be
# committed. Keep these rules if a config file is introduced later.
*.secret
*.local.ps1
credentials.*

# ---- Editor / OS ----
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
